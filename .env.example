# Example values for LOCAL development only. Never commit a real .env.
# Docker Compose resolves "db"; use "localhost" when running Python on the host.
DATABASE_URL=postgresql+psycopg://product:product_dev_password@db:5432/products
HOST=0.0.0.0
PORT=3030
WORKERS=1
LOG_LEVEL=info
CORS_ORIGINS=*
DB_CONNECT_TIMEOUT=5

# These configure the local PostgreSQL container, not application behavior.
POSTGRES_USER=product
POSTGRES_PASSWORD=product_dev_password
POSTGRES_DB=products
DB_PORT=5432
